    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.11.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.5.207",
