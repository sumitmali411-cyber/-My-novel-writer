# GEMINI_API_KEY: used ONLY by the Express server in server.ts.
# It must never be referenced from anything under src/, and must never be
# exposed through vite.config.ts `define` or a VITE_-prefixed name — both
# inline the value into the client bundle where every visitor can read it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SARVAM_API_KEY: used ONLY by the Express server for /api/sarvam/translate.
SARVAM_API_KEY="MY_SARVAM_API_KEY"
